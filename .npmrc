# Keep `npm install` inside a small sandbox's memory budget.
#
# Agent Etna clones this repo and installs it in an e2b sandbox to run a
# simulation. That build was being killed out of memory, which surfaces as an
# agent that never answers rather than as a build error.
#
# maxsockets caps concurrent fetch/extract, which is what drives peak memory —
# the default of 15 is tuned for a developer laptop, not a small container.
maxsockets=3

# Nothing here is needed to run the agent, and installing test tooling was
# costing a whole failed build before the installer retried without it.
omit=dev

audit=false
fund=false
progress=false
